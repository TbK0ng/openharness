# Python
__pycache__/
*.pyc
.venv/
.uv-cache/

# OpenHarness 配置/运行时目录（全部状态集中在工作区的 .oh/）
.oh/

# 本地 agent 工作区（技能库 / 输入历史 / 机器相关的 mcp.json）
.agents/

# 旧位置（保留忽略，便于从旧版本迁移）。
# 注意锚定到根目录：`memory/` 会误伤 openharness/memory/ 包目录。
/data/
hook_log*
*.log
/.openharness_worktrees/
/MEMORY.md
/memory/
/.tasks/
/settings.json
/plugins/

# probe scratch & test runtime artifacts（测试源码 tests/ 仍然入库）
_probe/
_tmp_tests/
oh_hooks_*/
oh_test_*/
tmp*/
pytest-cache-files-*/
.pytest_cache/

# 覆盖率与 lint/type-check 缓存
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# 编辑器 / 操作系统杂项
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# 临时/备份文件
*.tmp
*.bak
*.orig
*.rej

# Local MCP server binary (copied from %LOCALAPPDATA%\Programs\codebase-memory-mcp)
tools/codebase-memory-mcp/
cbm_temp/

dist/
build/
*.egg-info/
