# Python
__pycache__/
*.pyc
.venv/
.uv-cache/

# OpenHarness 配置/运行时目录（全部状态集中在工作区的 .oh/）
.oh/
# lab 是入库的沙盒，但它自己的运行态不入库
lab/.oh/

# 旧位置（保留忽略，便于从旧版本迁移）。
# 注意锚定到根目录：`memory/` 会误伤 openharness/memory/ 包目录。
/data/
hook_log*
*.log
/.openharness_worktrees/
/MEMORY.md
/memory/
/.tasks/
/settings.json
/plugins/

# probe scratch & test runtime artifacts
_probe/
_tmp_tests/
oh_hooks_*/
oh_test_*/
tmp*/
pytest-cache-files-*/
.pytest_cache/

# Local MCP server binary (installed via tools/codebase-memory-mcp/install.ps1)
tools/codebase-memory-mcp/
cbm_temp/

dist/
build/
*.egg-info/
